# BSV MCP Configuration

# Transport mode: 'stdio' (for Claude Code) or 'http' (default)
TRANSPORT=stdio

# Port for HTTP mode (default: 3000)
# PORT=3000

# --- OAuth 2.1 Authentication (Recommended) ---
# Enable OAuth authentication with sigma-auth
ENABLE_OAUTH=true

# OAuth issuer URL (sigma-auth server)
OAUTH_ISSUER=https://auth.sigmaidentity.com

# This resource server's URL (for JWT validation)
# RESOURCE_URL=http://localhost:3000

# --- Option 1: Local Wallet Mode (default) ---
# Run bsv-mcp init in a local terminal before starting the server.
BSV_MCP_ACCOUNT=default
# BSV_MCP_PASSWORD= # Supply through your process environment, never commit it.
# No keys are created automatically. Public reads only: DISABLE_WALLET_TOOLS=true
# Optional explicit private-key override:
# PRIVATE_KEY_WIF=YOUR_PRIVATE_KEY_WIF_HERE
# IDENTITY_KEY_WIF=YOUR_IDENTITY_KEY_WIF_HERE # Optional

# --- Option 2: Droplit API Mode ---
# Enable Droplit API mode for users without local wallets
USE_DROPLIT_API=false

# Droplit API configuration
DROPLIT_API_URL=http://127.0.0.1:4000
DROPLIT_FAUCET_NAME=test-faucet

# --- Feature Toggles ---
# Tool catalog profile: full is the default; uncomment for bounded read families.
# MCP_TOOL_CATALOG=compact

# Disable specific tool categories
# Deprecated: tutorial prompts have moved to skills; this setting is a no-op.
# DISABLE_PROMPTS=true
# DISABLE_RESOURCES=true
# DISABLE_TOOLS=true
# DISABLE_WALLET_TOOLS=true
# DISABLE_MNEE_TOOLS=true
# DISABLE_BSV_TOOLS=true
# DISABLE_ORDINALS_TOOLS=true
# DISABLE_UTILS_TOOLS=true
# DISABLE_BAP_TOOLS=true

# Disable transaction broadcasting for testing
# DISABLE_BROADCASTING=true
